class TestAPIIntegration:
    """Integration tests for API endpoints."""

    def test_create_via_api(self, authenticated_client):
        """
        Test creating a resource via API.

        Given: An authenticated client
        When: POST request is made to create endpoint
        Then: Resource is created and returned with 201 status
        """
        # Arrange
        data = {"name": "API Created", "value": 100}

        # Act
        response = authenticated_client.post("/api/entities/", json=data)

        # Assert
        assert response.status_code == 201
        assert response.json()["name"] == "API Created"
        assert "id" in response.json()

    def test_list_via_api(self, authenticated_client, sample_entities):
        """Test listing resources via API."""
        response = authenticated_client.get("/api/entities/")

        assert response.status_code == 200
        assert len(response.json()) >= len(sample_entities)

    def test_get_single_via_api(self, authenticated_client, sample_entities):
        """Test getting a single resource via API."""
        entity_id = sample_entities[0].id

        response = authenticated_client.get(f"/api/entities/{entity_id}/")

        assert response.status_code == 200
        assert response.json()["id"] == entity_id

    def test_update_via_api(self, authenticated_client, sample_entities):
        """Test updating a resource via API."""
        entity_id = sample_entities[0].id
        data = {"name": "API Updated"}

        response = authenticated_client.patch(f"/api/entities/{entity_id}/", json=data)

        assert response.status_code == 200
        assert response.json()["name"] == "API Updated"

    def test_delete_via_api(self, authenticated_client, sample_entities):
        """Test deleting a resource via API."""
        entity_id = sample_entities[0].id

        response = authenticated_client.delete(f"/api/entities/{entity_id}/")

        assert response.status_code == 204

    def test_unauthorized_access_returns_401(self, api_client):
        """Test that unauthorized access returns 401."""
        response = api_client.get("/api/entities/")

        assert response.status_code == 401


