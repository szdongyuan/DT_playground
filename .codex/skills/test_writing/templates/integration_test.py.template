# Performance Tests
# =============================================================================

class TestPerformance:
    """Performance-related integration tests."""

    @pytest.mark.slow
    def test_bulk_insert_performance(self, test_database):
        """Test that bulk insert completes within acceptable time."""
        import time

        service = EntityService(database=test_database)
        entities = [{"name": f"Entity {i}", "value": i} for i in range(1000)]

        start = time.time()
        service.bulk_create(entities)
        duration = time.time() - start

        assert duration < 5.0  # Should complete within 5 seconds
        assert test_database.query(Entity).count() >= 1000

    @pytest.mark.slow
    def test_concurrent_operations(self, test_database):
        """Test that concurrent operations don't cause issues."""
        import concurrent.futures

        service = EntityService(database=test_database)

        def create_entity(i):
            return service.create({"name": f"Concurrent {i}", "value": i})

        with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
            futures = [executor.submit(create_entity, i) for i in range(100)]
            results = [f.result() for f in futures]

        assert len(results) == 100
        assert all(r is not None for r in results)


# =============================================================================
# Error Recovery Tests
# =============================================================================

class TestErrorRecovery:
    """Tests for error recovery and resilience."""

    def test_transaction_rollback_on_error(self, test_database):
        """Test that transaction rolls back on error."""
        service = EntityService(database=test_database)
        initial_count = test_database.query(Entity).count()

        with pytest.raises(ValueError):
            service.create_with_validation({"name": "", "value": -1})  # Invalid

        # Verify no partial data was committed
        assert test_database.query(Entity).count() == initial_count

    def test_retry_on_transient_failure(self, test_database):
        """Test that transient failures trigger retry."""
        call_count = 0

        def flaky_operation():
            nonlocal call_count
            call_count += 1
            if call_count < 3:
                raise ConnectionError("Transient failure")
            return "success"

        service = ResilientService(database=test_database)
        result = service.execute_with_retry(flaky_operation)

        assert result == "success"
        assert call_count == 3
