# Integration Test: Database Operations
# =============================================================================

class TestDatabaseIntegration:
    """Integration tests for database operations."""

    def test_create_entity_persists_to_database(self, test_database):
        """
        Test that creating an entity persists it to the database.

        Given: A clean database
        When: An entity is created through the service
        Then: The entity can be retrieved from the database
        """
        # Arrange
        service = EntityService(database=test_database)
        entity_data = {"name": "New Entity", "value": 500}

        # Act
        created = service.create(entity_data)

        # Assert
        retrieved = test_database.query(Entity).filter_by(id=created.id).first()
        assert retrieved is not None
        assert retrieved.name == "New Entity"
        assert retrieved.value == 500

    def test_update_entity_modifies_database(self, test_database, sample_entities):
        """Test that updating an entity modifies the database record."""
        service = EntityService(database=test_database)
        entity = sample_entities[0]

        service.update(entity.id, {"name": "Updated Name"})

        updated = test_database.query(Entity).filter_by(id=entity.id).first()
        assert updated.name == "Updated Name"

    def test_delete_entity_removes_from_database(self, test_database, sample_entities):
        """Test that deleting an entity removes it from the database."""
        service = EntityService(database=test_database)
        entity = sample_entities[0]

        service.delete(entity.id)

        deleted = test_database.query(Entity).filter_by(id=entity.id).first()
        assert deleted is None

    def test_query_returns_filtered_results(self, test_database, sample_entities):
        """Test that query returns correctly filtered results."""
        service = EntityService(database=test_database)

        results = service.query(min_value=150)

        assert len(results) == 2
        assert all(r.value >= 150 for r in results)


