class TestWithExternalMocks:
    """Tests that require mocking external dependencies."""

    @patch("{{PACKAGE}}.{{MODULE}}.external_service")
    def test_with_patched_service(self, mock_service):
        """Test with patched external service."""
        mock_service.call.return_value = "mocked"

        result = function_under_test()

        assert result == "expected"
        mock_service.call.assert_called_once()

    @patch("{{PACKAGE}}.{{MODULE}}.datetime")
    def test_with_frozen_time(self, mock_datetime):
        """Test with frozen time."""
        from datetime import datetime
        mock_datetime.now.return_value = datetime(2024, 1, 1, 12, 0, 0)

        result = get_timestamp()

        assert result == "2024-01-01 12:00:00"

    @patch.dict("os.environ", {"API_KEY": "test-key"})
    def test_with_env_variables(self):
        """Test with mocked environment variables."""
        import os

        result = get_api_key()

        assert result == "test-key"


