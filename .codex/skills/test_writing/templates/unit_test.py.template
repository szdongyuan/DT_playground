class TestAsyncFunctions:
    """Tests for async functions."""

    @pytest.mark.asyncio
    async def test_async_function_success(self):
        """Test async function succeeds."""
        result = await async_function(valid_input)

        assert result == expected

    @pytest.mark.asyncio
    async def test_async_function_with_mock(self):
        """Test async function with mocked dependency."""
        mock_client = AsyncMock()
        mock_client.fetch.return_value = {"data": "value"}

        result = await function_with_client(mock_client)

        assert result == "expected"
        mock_client.fetch.assert_awaited_once()

    @pytest.mark.asyncio
    @patch("{{PACKAGE}}.{{MODULE}}.async_external_call", new_callable=AsyncMock)
    async def test_async_with_patched_call(self, mock_call):
        """Test async function with patched external call."""
        mock_call.return_value = "mocked"

        result = await function_that_awaits()

        assert result == "expected"
