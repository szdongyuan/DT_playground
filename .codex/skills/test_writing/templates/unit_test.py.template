class Test{{CLASS_NAME}}:
    """Unit tests for {{CLASS_NAME}}."""

    # -------------------------------------------------------------------------
    # Happy Path Tests
    # -------------------------------------------------------------------------

    def test_method_success_with_valid_input(self, instance, sample_data):
        """
        Test that method succeeds with valid input.

        Given: Valid input data
        When: method is called
        Then: Expected result is returned
        """
        # Arrange
        expected = "expected_result"

        # Act
        result = instance.method(sample_data)

        # Assert
        assert result == expected

    def test_method_returns_correct_type(self, instance):
        """Test that method returns the correct type."""
        result = instance.method(valid_input)

        assert isinstance(result, ExpectedType)

    # -------------------------------------------------------------------------
    # Parametrized Tests
    # -------------------------------------------------------------------------

    @pytest.mark.parametrize("input_value,expected", [
        ("valid_1", "result_1"),
        ("valid_2", "result_2"),
        ("valid_3", "result_3"),
    ], ids=["case_1", "case_2", "case_3"])
    def test_method_with_various_inputs(self, instance, input_value, expected):
        """Test method with various valid inputs."""
        result = instance.method(input_value)

        assert result == expected

    # -------------------------------------------------------------------------
    # Boundary Value Tests
    # -------------------------------------------------------------------------

    def test_method_with_minimum_value(self, instance):
        """Test method with minimum boundary value."""
        result = instance.method(min_value)

        assert result == expected_for_min

    def test_method_with_maximum_value(self, instance):
        """Test method with maximum boundary value."""
        result = instance.method(max_value)

        assert result == expected_for_max

    def test_method_with_empty_input(self, instance):
        """Test method with empty input."""
        result = instance.method("")

        assert result == expected_for_empty

    # -------------------------------------------------------------------------
    # Error Handling Tests
    # -------------------------------------------------------------------------

    def test_method_raises_error_for_invalid_input(self, instance):
        """Test that method raises ValueError for invalid input."""
        with pytest.raises(ValueError, match="Invalid input"):
            instance.method(invalid_input)

    def test_method_raises_error_for_none_input(self, instance):
        """Test that method raises TypeError for None input."""
        with pytest.raises(TypeError):
            instance.method(None)

    # -------------------------------------------------------------------------
    # Mock Verification Tests
    # -------------------------------------------------------------------------

    def test_method_calls_dependency_correctly(self, instance, mock_dependency):
        """Test that method calls dependency with correct arguments."""
        instance.method("input")

        mock_dependency.method.assert_called_once_with("expected_arg")

    def test_method_handles_dependency_failure(self, instance, mock_dependency):
        """Test that method handles dependency failure gracefully."""
        mock_dependency.method.side_effect = RuntimeError("Dependency failed")

        with pytest.raises(RuntimeError):
            instance.method("input")


