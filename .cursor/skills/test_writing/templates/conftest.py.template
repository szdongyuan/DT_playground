# =============================================================================
# Assertion Helpers
# =============================================================================

@pytest.fixture
def assert_dict_contains():
    """
    Helper to assert a dict contains expected key-value pairs.
    
    Usage:
        def test_something(assert_dict_contains):
            result = {"a": 1, "b": 2, "c": 3}
            assert_dict_contains(result, {"a": 1, "b": 2})
    """
    def _assert(actual, expected):
        for key, value in expected.items():
            assert key in actual, f"Key '{key}' not found in {actual}"
            assert actual[key] == value, f"Expected {key}={value}, got {actual[key]}"
    
    return _assert


@pytest.fixture
def assert_raises_with_message():
    """
    Helper to assert an exception with specific message.
    
    Usage:
        def test_something(assert_raises_with_message):
            with assert_raises_with_message(ValueError, "Invalid input"):
                raise ValueError("Invalid input provided")
    """
    from contextlib import contextmanager
    
    @contextmanager
    def _assert(exc_type, message_contains):
        with pytest.raises(exc_type) as exc_info:
            yield
        assert message_contains in str(exc_info.value)
    
    return _assert


