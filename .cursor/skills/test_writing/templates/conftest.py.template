@pytest.fixture
def mock_datetime(mocker):
    """
    Provide a frozen datetime for testing.
    
    Usage:
        def test_something(mock_datetime):
            mock_datetime(2024, 1, 15, 12, 0, 0)
    """
    from datetime import datetime
    
    def _freeze(year, month, day, hour=0, minute=0, second=0):
        frozen = datetime(year, month, day, hour, minute, second)
        mock = mocker.patch("datetime.datetime")
        mock.now.return_value = frozen
        mock.utcnow.return_value = frozen
        return frozen
    
    return _freeze


